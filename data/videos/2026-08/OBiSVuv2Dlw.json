  "script": {
    "segments": [
      {
        "narration": "120 feet beneath Lake Huron sits an ancient stone wall. Sonar mapped parallel lines of stacked boulders stretching across the dark lakebed.",
        "visual_query": "lake huron underwater sonar scanning",
        "visual_fallback": "deep underwater lakebed"
      },
      {
        "narration": "These were no natural rock piles. They formed clear drive lanes complete with circular stone blinds tucked along the sides.",
        "visual_query": "underwater lake huron stone wall boulders",
        "visual_fallback": "underwater rock formation"
      },
      {
        "narration": "Who could build a complex hunting trap deep underwater? The massive structure made no sense in modern geography.",
        "visual_query": "great lakes deep water dark blue",
        "visual_fallback": "dark underwater lake"
      },
      {
        "narration": "In 2014, archaeologists uncovered the truth. Nine thousand years ago, ice age water levels were two hundred feet lower, leaving dry land.",
        "visual_query": "archaeologists analyzing underwater sonar data",
        "visual_fallback": "archaeology map research"
      },
      {
        "narration": "Paleo-Indian hunters built the walls to trap migrating caribou herds, right before melting glaciers flooded the entire canyon.",
        "visual_query": "ice age landscape ancient north america",
        "visual_fallback": "ancient glacial valley landscape"
      }
