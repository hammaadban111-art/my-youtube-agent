  "script": {
    "segments": [
      {
        "narration": "Deep ocean hydrophones recorded an impossible, house-shaking roar in 1997. NOAA underwater listening devices picked up an ultra-low frequency acoustic pulse in the remote Pacific.",
        "visual_query": "deep sea pacific ocean water",
        "visual_fallback": "dark ocean waves"
      },
      {
        "narration": "The noise was so immense that acoustic sensors separated by over 3,000 miles detected it clearly. Yet no known animal, submarine, or seismic event matched its unique signature.",
        "visual_query": "ocean sonar hydrophone equipment",
        "visual_fallback": "scientific computer screens"
      },
      {
        "narration": "Could an undiscovered leviathan inhabit the unexplored deep sea trenches?",
        "visual_query": "deep sea ocean trench",
        "visual_fallback": "dark underwater abyss"
      },
      {
        "narration": "Years later, polar researchers unlocked the truth. The sound was not a biological monster, but the violent fracturing of glacial ice.",
        "visual_query": "antarctic glacier ice calving",
        "visual_fallback": "melting icebergs"
      },
      {
        "narration": "Massive icequakes cracking off the Antarctic shelf generate these exact organic-sounding acoustic booms as massive ice sheets break apart.",
        "visual_query": "massive antarctic ice shelf",
        "visual_fallback": "frozen polar landscape"
      }
    ],
