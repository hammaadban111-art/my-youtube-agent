  "script": {
    "segments": [
      {
        "narration": "Divers pulled a 2,000-year-old computer from a Roman-era shipwreck. In 1901, sponge divers off Antikythera spotted a strange calcified lump.",
        "visual_query": "mediterranean underwater shipwreck scuba diver seabed",
        "visual_fallback": "underwater ocean floor"
      },
      {
        "narration": "Decades later, X-rays revealed over thirty interlocking bronze gears inside. Its precision rivaled 18th-century clockwork.",
        "visual_query": "ancient greek corroded bronze artifact museum",
        "visual_fallback": "vintage clockwork gears"
      },
      {
        "narration": "How could ancient builders craft technology this advanced fifteen centuries early? No other device like it existed on Earth.",
        "visual_query": "ancient greece temple ruins aegean coastline",
        "visual_fallback": "ancient stone ruins"
      },
      {
        "narration": "3D scans finally decoded hidden Greek inscriptions inside the bronze. It was a hand-cranked mechanical calculator built to track planetary motion and predict eclipses.",
        "visual_query": "3d scan laboratory x-ray screen research",
        "visual_fallback": "scientific screen animation"
      },
      {
        "narration": "Greek engineers built a functional mechanical computer over a thousand years before modern history thought possible.",
        "visual_query": "ancient greek astrolabe planetarium mechanism model",
