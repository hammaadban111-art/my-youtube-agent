  "script": {
    "segments": [
      {
        "narration": "Wounded Civil War soldiers suddenly began glowing in the dark. In 1862, after the Battle of Shiloh, injured troops lay stranded for days in freezing mud.",
        "visual_query": "civil war battlefield muddy landscape",
        "visual_fallback": "foggy muddy field"
      },
      {
        "narration": "As night fell, a faint blue-green light radiated from their skin. Incredibly, the glowing men healed faster and survived at twice the rate of others.",
        "visual_query": "bioluminescent blue glow dark field",
        "visual_fallback": "glowing blue light"
      },
      {
        "narration": "How could a mysterious night glow cure lethal battlefield infections? For over a century, baffled doctors simply called it Angel\u2019s Glow.",
        "visual_query": "19th century medical tent field hospital",
        "visual_fallback": "vintage doctor tent"
      },
      {
        "narration": "The answer came in 2001 from a high school science fair project. Freezing mud gave soldiers hypothermia, allowing a glowing soil bacteria named Photorhabdus luminescens to thrive.",
        "visual_query": "microscope glowing bioluminescent bacteria lab",
        "visual_fallback": "microbiology laboratory microscope"
      },
      {
        "narration": "The luminescent bacteria pumped out natural antibiotics, killing deadly pathogens before the men even reached a hospital. A glowing microbe had saved them.",
        "visual_query": "historic civil war soldier silhouettes sunset",
        "visual_fallback": "soldiers walking silhouette"
      }
