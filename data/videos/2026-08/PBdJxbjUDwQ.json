  "script": {
    "segments": [
      {
        "narration": "A man chased an escaped chicken into an eighteen-story underground city. In 1963, a Turkish homeowner knocked down a basement wall and uncovered a secret tunnel.",
        "visual_query": "cappadocia turkey village landscape",
        "visual_fallback": "village stone houses"
      },
      {
        "narration": "The passage plunged nearly three hundred feet into solid volcanic rock. It wasn't a simple cave, but a sprawling multi-level labyrinth.",
        "visual_query": "derinkuyu underground city tunnels cappadocia",
        "visual_fallback": "dark stone underground tunnel"
      },
      {
        "narration": "How did an ancient metropolis stay hidden beneath ordinary houses? Excavators found fresh-air ventilation shafts, stables, and deep water wells carved below.",
        "visual_query": "derinkuyu ventilation shafts underground cappadocia",
        "visual_fallback": "ancient underground carved chambers"
      },
      {
        "narration": "Massive half-ton stone doors sealed the corridors from the inside only. This was an ancient bomb shelter, built millennia before bombs existed.",
        "visual_query": "derinkuyu stone door cappadocia turkey",
        "visual_fallback": "ancient stone circular door"
      },
      {
        "narration": "Early Christians and Phrygians hand-carved Derinkuyu to hide twenty thousand people from invading armies. An entire civilization, uncovered by an escaping bird.",
        "visual_query": "cappadocia underground city aerial landscape",
        "visual_fallback": "ancient underground carved city"
      }
    ],
