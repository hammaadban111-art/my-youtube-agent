  "script": {
    "segments": [
      {
        "narration": "Locals dumped ping pong balls down a waterfall and they vanished. At Minnesota's Devil's Kettle, half the river plunges into a mysterious stone hole.",
        "visual_keywords": "rushing waterfall forest"
      },
      {
        "narration": "Visitors reportedly dropped sticks, ping-pong balls, and GPS trackers into the pothole without seeing them resurface. Researchers planned a dye tracing experiment in 2017, but ultimately did not conduct it.",
        "visual_keywords": "floating objects river"
      },
      {
        "narration": "Was the water draining into a subterranean cavern? People believed the hole opened into a secret underground abyss.",
        "visual_keywords": "dark cave water"
      },
      {
        "narration": "In 2017, hydrologists finally measured the water volume above and below the falls. The flow rate was identical.",
        "visual_keywords": "scientists measuring river"
      },
      {
        "narration": "The missing water actually rejoined the river underwater, where violent hydraulic vortexes pulverised every ping pong ball instantly.",
        "visual_keywords": "churning water plunge"
      }
    ],
