  "script": {
    "segments": [
      {
        "narration": "This 9,000-year-old town had no streets at all. Southern Turkey, on the Konya Plain. No lanes, no doors at ground level. People came and went across the rooftops.",
        "visual_query": "konya plain anatolian steppe",
        "visual_fallback": "dry plain"
      },
      {
        "narration": "Houses packed wall to wall in a honeycomb. You dropped in through a hole in the ceiling, which was also the chimney.",
        "visual_query": "neolithic mudbrick village excavation",
        "visual_fallback": "mud walls"
      },
      {
        "narration": "And the dead stayed home. They lie in pits under the floors, beneath the hearths and sleeping platforms. The earliest graves hold close relatives.",
        "visual_query": "anatolian archaeological dig trench",
        "visual_fallback": "dig site"
      },
      {
        "narration": "Eighteen levels of this stack up. Each house rebuilt on the flattened one below it, for roughly fifteen hundred years.",
        "visual_query": "mudbrick ruins turkey hillside",
        "visual_fallback": "earth mound"
      },
      {
        "narration": "Genetics published in 2025 points to homes handed down from mother to daughter. A town laid out by who you were related to, not by roads.",
        "visual_query": "anatolian plain dawn landscape",
        "visual_fallback": "flat steppe"
      }
    ],
    "segment_count": 5,
    "word_count": 120,
