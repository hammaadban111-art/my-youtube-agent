      {
        "claim": "Rev. John Danforth drew the petroglyphs in 1680, the drawing is held by the British Museum, and Cotton Mather described the rock in 1690.",
        "segment_index": 1,
        "verdict": "SUPPORTED",
        "note": "85% of the claim's wording appears in the reference article, including 2 number(s)",
        "correction": null,
        "method": "wikipedia-lexical"
      },
      {
        "claim": "Ezra Stiles proposed a Phoenician origin in 1783, Carl Christian Rafn a Norse origin in 1837, and Gavin Menzies a Chinese origin in 2002.",
        "segment_index": 2,
        "verdict": "SUPPORTED",
        "note": "100% of the claim's wording appears in the reference article, including 3 number(s)",
        "correction": null,
        "method": "wikipedia-lexical"
      },
      {
        "claim": "Edmund Delabarre of Brown University read the inscription as naming Miguel Corte-Real and the year 1511, and Douglas Hunter debunked that reading in 2017.",
        "segment_index": 3,
        "verdict": "SUPPORTED",
        "note": "87% of the claim's wording appears in the reference article, including 2 number(s)",
        "correction": null,
        "method": "wikipedia-lexical"
