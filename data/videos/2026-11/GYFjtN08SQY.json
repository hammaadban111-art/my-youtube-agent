  "script": {
    "segments": [
      {
        "narration": "A Maya book called fake for decades is the oldest. Ten bark-paper pages, an almanac tracking Venus, radiocarbon dated to between 1021 and 1154 AD.",
        "visual_query": "mayan codex glyph painted page",
        "visual_fallback": "ancient manuscript"
      },
      {
        "narration": "Its arrival helped nobody believe it. A collector said he was flown in 1965 to an airstrip in Tabasco and shown the thing there.",
        "visual_query": "tabasco jungle airstrip aerial",
        "visual_fallback": "jungle canopy"
      },
      {
        "narration": "No excavation records, no site, no paperwork at all. How do you ever prove a looted book is genuine?",
        "visual_query": "mayan temple ruins chiapas jungle",
        "visual_fallback": "stone ruins"
      },
      {
        "narration": "Chemistry did it. Mexico's INAH found gypsum-prepared paper and pigments of lamp black, hematite red and Maya blue, all aged together with the sheets.",
        "visual_query": "conservation laboratory manuscript pigment analysis",
        "visual_fallback": "research lab"
      },
      {
        "narration": "In 2018 INAH declared the codex authentic and renamed it the Codice Maya de Mexico, the oldest surviving book anywhere in the Americas.",
        "visual_query": "mexican museum ancient artifact display",
        "visual_fallback": "museum gallery"
      }
    ],
