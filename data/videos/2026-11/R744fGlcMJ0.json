      },
      {
        "claim": "Workers cut trenches around the structures with hammers and chisels in scoriaceous basalt, carving top-down so the lowest part is cut last.",
        "segment_index": 1,
        "verdict": "SUPPORTED",
        "note": "Wikipedia names the hammers, chisels and scoriaceous basalt and the trenches; the Met states the top-down approach 'leaves the most recently hewn element at the bottom'.",
        "correction": null,
