  "script": {
    "segments": [
      {
        "narration": "Parliament soaked its curtains in lime to survive the smell. London, summer 1858. The Thames was the city's open sewer.",
        "visual_query": "victorian london parliament thames",
        "visual_fallback": "old parliament"
      },
      {
        "narration": "Three million people, about two hundred thousand cesspits, and 360 sewers all emptying into the river. Then June hit thirty-six degrees and the water dropped.",
        "visual_query": "victorian london street slum",
        "visual_fallback": "victorian street"
      },
      {
        "narration": "Officials seriously discussed moving the government to Oxford, or to St Albans. Nothing concentrates a legislature like a smell it cannot escape.",
        "visual_query": "houses of parliament river thames",
        "visual_fallback": "river thames"
      },
      {
        "narration": "A bill went in on the fifteenth of June and was law by the second of August. Joseph Bazalgette got three million pounds and built eighty-two miles of interceptor sewers.",
        "visual_query": "victorian brick sewer tunnel",
        "visual_fallback": "brick tunnel"
      },
      {
        "narration": "It took 318 million bricks and eleven hundred miles of street sewers. London's last cholera outbreak was 1866, and the thing still runs.",
        "visual_query": "london thames embankment victorian",
        "visual_fallback": "river embankment"
      }
