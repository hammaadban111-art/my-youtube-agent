  "script": {
    "segments": [
      {
        "narration": "Rubber slabs stamped with one strange word keep landing on European beaches. The word is TJIPETIR. Nobody who found one had ever heard of it.",
        "visual_query": "cornwall rocky beach waves",
        "visual_fallback": "cold surf"
      },
      {
        "narration": "A Cornish beachcomber picked hers up in 2012, then logged sightings from France, Spain, the Netherlands, Norway. More arrive every year.",
        "visual_query": "northern european beachcombing shoreline",
        "visual_fallback": "wet sand"
      },
      {
        "narration": "What delivers identical century-old blocks to a dozen coastlines at once? Gutta-percha barely rots in seawater. It simply waits.",
        "visual_query": "atlantic surf pebble strand",
        "visual_fallback": "grey waves"
      },
      {
        "narration": "Tjipetir was a plantation in West Java, pressing that tree sap into blocks a hundred years ago, and shipping them out by sea.",
        "visual_query": "west java plantation green hills",
        "visual_fallback": "green plantation"
      },
      {
        "narration": "Britain's Receiver of Wreck favours one answer: the Miyazaki Maru, a liner torpedoed in 1917, still releasing its cargo. Nobody has proved it.",
        "visual_query": "early steamship archive footage",
        "visual_fallback": "old steamer"
      }
    ],
