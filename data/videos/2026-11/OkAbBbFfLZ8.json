  "script": {
    "segments": [
      {
        "narration": "A physicist watched one funnel for fifty-two years and saw nothing. John Mainstone took charge of the pitch drop experiment in 1961.",
        "visual_query": "university queensland physics laboratory interior",
        "visual_fallback": "physics laboratory"
      },
      {
        "narration": "Thomas Parnell poured hot pitch into a sealed funnel at the University of Queensland in 1927. He cut the stem three years later.",
        "visual_query": "brisbane university laboratory glass funnel",
        "visual_fallback": "glass funnel"
      },
      {
        "narration": "Then it just hung there. Pitch looks like a solid you could shatter, but it flows, over a hundred billion times thicker than water.",
        "visual_query": "black tar pitch slowly flowing",
        "visual_fallback": "slow black tar"
      },
      {
        "narration": "Nine drops have fallen in ninety-nine years. Mainstone missed the 1988 one by stepping out for a drink, and a webcam failed in 2000.",
        "visual_query": "queensland laboratory glass display case",
        "visual_fallback": "laboratory glass case"
      },
      {
        "narration": "He died in 2013, months before the ninth drop broke free. Nobody has ever seen one fall in person.",
        "visual_query": "australian university physics museum display",
        "visual_fallback": "museum display case"
      }
    ],
