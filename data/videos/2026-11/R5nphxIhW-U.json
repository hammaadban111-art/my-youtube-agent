        "verdict": "SUPPORTED",
        "note": "100% of the claim's wording appears in the reference article, including 2 number(s)",
        "correction": null,
        "method": "wikipedia-lexical"
      },
      {
        "claim": "The line existed to enforce the salt tax and collect sugar duty, and was built from thorny species including Indian plum, babool and prickly pear, reaching 3.7 metres high and 4.3 metres thick in places.",
        "segment_index": 1,
        "verdict": "SUPPORTED",
        "note": "91% of the claim's wording appears in the reference article, including 3 number(s)",
        "correction": null,
        "method": "wikipedia-lexical"
      },
      {
        "claim": "Staff on the customs line peaked at 14,188 men in 1872, and there were 1,727 customs posts in 1869 to 1870.",
        "segment_index": 2,
