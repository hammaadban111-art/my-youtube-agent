        "correction": null,
        "method": "wikipedia-lexical"
      },
      {
        "claim": "Ferdinand von Hochstetter's 1859 survey is considered the most accurate record of the pre-eruption lake, and his field diary was found in the Hochstetter Collection Basel when Sascha Nolden took up its curation in 2010.",
        "segment_index": 3,
