    "verdicts": [
      {
        "claim": "Two skeletons excavated at Cladh Hallan on South Uist in 2001 were each assembled from the bones of at least three different individuals.",
        "segment_index": 0,
        "verdict": "SUPPORTED",
        "note": "93% of the claim's wording appears in the reference article, including 1 number(s)",
        "correction": null,
        "method": "wikipedia-lexical"
      },
      {
        "claim": "Ancient mitochondrial DNA published in 2012 showed the mandible, right humerus and right femur of one Cladh Hallan skeleton came from different individuals, and its female-type pelvis was paired with a male-type skull and jaw.",
        "segment_index": 1,
        "verdict": "SUPPORTED",
        "note": "Attributed to Hanna et al., Journal of Archaeological Science 39(8) 2012, pp. 2774-2779, which sampled skull, mandible, right humerus and right femur; the skull yielded too little DNA to place. Osteology gave a female-consistent pelvis with a male-type skull and mandible.",
        "correction": null,
        "method": "claude-research",
        "source": "https://en.wikipedia.org/wiki/Cladh_Hallan_Mummies"
      },
      {
        "claim": "The bodies were kept for centuries before burial: one man died about 1600 BC and the woman about 1300 BC, and neither was buried until roughly 1120 BC.",
        "segment_index": 2,
        "verdict": "SUPPORTED",
        "note": "The Cladh Hallan Mummies article gives those death dates and a burial around 1120 BCE, about 500 years for the male and 180 for the female.",
        "correction": null,
        "method": "claude-research",
        "source": "https://en.wikipedia.org/wiki/Cladh_Hallan_Mummies"
      },
      {
        "claim": "Limited demineralisation of the outer bone, with radiocarbon dating, indicates the bodies spent roughly 6 to 18 months in a peat bog shortly after death, which halted decay.",
        "segment_index": 3,
        "verdict": "SUPPORTED",
        "note": "The article states limited demineralisation of the outer bone layers with radiocarbon dates supports placement in a bog for roughly 6 to 18 months shortly after death, most likely a peat bog's acidic environment.",
        "correction": null,
        "method": "claude-research",
        "source": "https://en.wikipedia.org/wiki/Cladh_Hallan_Mummies"
      },
      {
        "claim": "Researchers including Mike Parker Pearson have suggested the composites merged separate ancestral identities or lines of descent into one body, and the purpose remains uncertain.",
        "segment_index": 4,
        "verdict": "SUPPORTED",
        "note": "70% of the claim's wording appears in the reference article",
        "correction": null,
        "method": "wikipedia-lexical"
      }
