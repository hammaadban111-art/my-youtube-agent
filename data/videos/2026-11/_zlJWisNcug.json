  "script": {
    "segments": [
      {
        "narration": "This skeleton was built from three different people. South Uist, in the Outer Hebrides. Dug out from under a Bronze Age house floor in 2001.",
        "visual_query": "outer hebrides machair coast",
        "visual_fallback": "windswept coast"
      },
      {
        "narration": "The pelvis read female. The skull and jaw read male. DNA work in 2012 showed the jaw, the arm and the leg came from three bodies.",
        "visual_query": "bronze age roundhouse excavation",
        "visual_fallback": "dig trench"
      },
      {
        "narration": "Who assembles a person out of spare parts? Someone who had been keeping those parts for centuries. One of these men died around 1600 BC.",
        "visual_query": "scottish archaeological dig trench",
        "visual_fallback": "stone foundations"
      },
      {
        "narration": "The bone chemistry points to months in a peat bog. The acid stopped the decay. Then the bodies were lifted back out again.",
        "visual_query": "highland peat bog moorland",
        "visual_fallback": "dark peat"
      },
      {
        "narration": "He was not buried until about 1120 BC. The leading reading is deliberate: separate ancestors merged into one body, for reasons still argued over.",
        "visual_query": "hebridean coastal grass dunes",
        "visual_fallback": "grey islands"
      }
    ],
    "segment_count": 5,
    "word_count": 123,
    "duration_seconds": 35.0,
    "voice": "en-US-GuyNeural",
    "tts_rate": "+8%",
