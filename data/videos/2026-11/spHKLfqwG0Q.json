  "script": {
    "segments": [
      {
        "narration": "This book has 448 pages and no readable word. Hungary has owned it since 1838 and still cannot open it.",
        "visual_query": "old handwritten manuscript pages",
        "visual_fallback": "old manuscript"
      },
      {
        "narration": "Count Batthyany handed it to the Hungarian Academy of Sciences with his entire library. Eighty-seven drawings sit inside: churches, soldiers, battles.",
        "visual_query": "hungarian baroque library interior",
        "visual_fallback": "old library"
      },
      {
        "narration": "One scholar counted 792 different symbols. Far too many for an alphabet. Readings in Hungarian, Romanian and Hindi have all been published, and all thrown out. Who fills 448 pages with nothing?",
        "visual_query": "medieval manuscript symbols closeup",
        "visual_fallback": "inked symbols"
      },
      {
        "narration": "Most Hungarian scholars think somebody did exactly that, deliberately. Samuel Literati Nemes, a dealer who forged manuscripts in the 1830s, has been the suspect since 1866.",
        "visual_query": "19th century antiquarian desk",
        "visual_fallback": "antique desk"
      },
      {
        "narration": "The paper is Venetian, made around the 1530s. Not one document ties Nemes to the book, so the best theory anyone has is still a suspicion.",
        "visual_query": "venetian paper mill watermark",
        "visual_fallback": "aged paper"
      }
    ],
