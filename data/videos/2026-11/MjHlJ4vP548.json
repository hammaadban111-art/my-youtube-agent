      {
        "claim": "Gage was a blasting foreman for the Rutland and Burlington Railroad, and the tamping iron was 3 feet 7 inches long, 1.25 inches across and weighed about 13.25 pounds.",
        "segment_index": 1,
        "verdict": "SUPPORTED",
        "note": "73% of the claim's wording appears in the reference article, including 5 number(s)",
        "correction": null,
        "method": "wikipedia-lexical"
      },
      {
        "claim": "Physician Edward H. Williams found Gage sitting in a chair outside his hotel about 30 minutes after the accident.",
        "segment_index": 2,
