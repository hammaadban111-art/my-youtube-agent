  "script": {
    "segments": [
      {
        "narration": "An iron rod went through his head and he walked. Cavendish, Vermont, the thirteenth of September, 1848. Three foot seven of solid iron.",
        "visual_query": "vermont railway track autumn",
        "visual_fallback": "railroad track"
      },
      {
        "narration": "Phineas Gage was packing blasting powder when the charge went off early. The rod weighed thirteen pounds and passed clean through his skull.",
        "visual_query": "iron rod metal workshop",
        "visual_fallback": "iron bar"
      },
      {
        "narration": "He was talking within minutes. A doctor found him sitting in a chair outside the hotel half an hour later. How is that survivable?",
        "visual_query": "old new england hotel building",
        "visual_fallback": "wooden hotel"
      },
      {
        "narration": "John Harlow treated him, drained an abscess, and twenty years on wrote that friends said he was no longer Gage. That line built a legend.",
        "visual_query": "antique medical instruments desk",
        "visual_fallback": "old medical tools"
      },
      {
        "narration": "Gage drove stagecoaches across Chile for years. Scans of his actual skull show only the left frontal lobe was hit.",
        "visual_query": "chilean andes dirt road",
        "visual_fallback": "dirt road"
      }
    ],
