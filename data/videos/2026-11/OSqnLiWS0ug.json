    "verdicts": [
      {
        "claim": "The 1940 Tacoma Narrows Bridge opened on 1 July 1940 and collapsed on 7 November 1940 in a wind of about 40 mph.",
        "segment_index": 0,
        "verdict": "SUPPORTED",
        "note": "100% of the claim's wording appears in the reference article, including 4 number(s)",
        "correction": null,
        "method": "wikipedia-lexical"
      },
      {
        "claim": "Construction workers nicknamed the bridge Galloping Gertie because its deck moved vertically in the wind.",
        "segment_index": 1,
        "verdict": "SUPPORTED",
        "note": "92% of the claim's wording appears in the reference article",
        "correction": null,
        "method": "wikipedia-lexical"
      },
      {
        "claim": "On the morning of the collapse the deck's motion changed to a twisting torsional mode, with one side of the roadway rising as the other fell, and it fell at about 11:00 a.m.",
        "segment_index": 2,
        "verdict": "SUPPORTED",
        "note": "80% of the claim's wording appears in the reference article, including 2 number(s)",
        "correction": null,
        "method": "wikipedia-lexical"
      },
      {
        "claim": "The accepted explanation is aeroelastic flutter, a self-exciting unbounded torsional motion, and Theodore von Karman sat on the Federal Works Agency board that investigated the collapse.",
        "segment_index": 3,
        "verdict": "SUPPORTED",
        "note": "Wikipedia states the collapse was caused by aeroelastic flutter that was self-exciting and unbounded, that the older resonance explanation based on Karman vortex shedding is incorrect though still common in textbooks, and that the Federal Works Agency commission was Othmar Ammann, Theodore von Karman and Glenn B. Woodruff.",
        "correction": null,
        "method": "claude-research",
        "source": "https://en.wikipedia.org/wiki/Tacoma_Narrows_Bridge_(1940)"
      },
      {
        "claim": "No person died in the collapse; the only fatality was a cocker spaniel named Tubby, and the wreckage lies about 180 feet down and is on the National Register of Historic Places.",
        "segment_index": 4,
        "verdict": "SUPPORTED",
        "note": "Wikipedia reports no human deaths, the death of the cocker spaniel Tubby left in Coatsworth's car, and wreckage about 180 feet (55 m) deep that is listed on the National Register of Historic Places. HistoryLink states the dog was the only fatality.",
        "correction": null,
