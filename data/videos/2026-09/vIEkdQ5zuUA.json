  "comments": [],
  "script": {
    "segments": [
      {
        "narration": "Hikers found a body that turned out to be 5000 years old. Nineteen ninety-one, the \u00d6tztal Alps, sticking out of melting ice.",
        "visual_query": "alpine glacier rocky ridge",
        "visual_fallback": "glacier ice"
      },
      {
        "narration": "He came with his gear. A copper axe, a yew bow, a birch-bark container, and shoes stuffed with grass.",
        "visual_query": "prehistoric tools copper axe",
        "visual_fallback": "ancient tools"
      },
      {
        "narration": "His skin carries sixty-one tattoos, mostly lines and crosses, and many sit over joints that show wear.",
        "visual_query": "ancient tattoo marks skin",
        "visual_fallback": "skin closeup"
      },
      {
        "narration": "For ten years everyone assumed he froze. Then in two thousand and one an X-ray found a flint arrowhead in his left shoulder.",
        "visual_query": "x ray medical scan display",
        "visual_fallback": "medical scan"
      },
      {
        "narration": "It had cut an artery. He bled out on that pass, and the ice kept the evidence for fifty-three centuries.",
        "visual_query": "high alpine mountain pass",
        "visual_fallback": "mountain pass"
      }
    ],
