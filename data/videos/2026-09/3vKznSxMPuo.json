  "script": {
    "segments": [
      {
        "narration": "A stranger paid cash for a monument and disappeared. Elbert County, Georgia, nineteen seventy-nine.",
        "visual_query": "granite quarry stone slabs",
        "visual_fallback": "granite stone"
      },
      {
        "narration": "What went up was six metres of granite: four upright slabs, a centre column and a capstone, weighing over a hundred tonnes.",
        "visual_query": "standing granite monument field",
        "visual_fallback": "stone monument"
      },
      {
        "narration": "Each face carried the same ten precepts in a different language. Eight languages in total, from English to Swahili to Hindi.",
        "visual_query": "engraved stone inscription closeup",
        "visual_fallback": "carved inscription"
      },
      {
        "narration": "It worked as an instrument too. A hole tracked the North Star, a slot marked the solstices, and a shaft lit the date at noon.",
        "visual_query": "sunlight through stone aperture",
        "visual_fallback": "sun through gap"
      },
      {
        "narration": "On the sixth of July twenty twenty-two someone blew up one slab. The county demolished the rest that afternoon for safety, and nobody has been charged.",
        "visual_query": "demolished stone rubble site",
        "visual_fallback": "stone rubble"
      }
    ],
