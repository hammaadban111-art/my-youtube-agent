  "script": {
    "segments": [
      {
        "narration": "Sixty people were left on a sandbank for fifteen years. No trees, no fresh water, and a promise someone would come back.",
        "visual_query": "flat sand island indian ocean",
        "visual_fallback": "sand island"
      },
      {
        "narration": "The Utile was a French slave ship. She struck this island in July 1761, carrying Malagasy captives illegally.",
        "visual_query": "18th century sailing ship reef",
        "visual_fallback": "ship reef"
      },
      {
        "narration": "The crew built a boat from the wreck. In September, 122 Frenchmen sailed off and left everyone else on the sand.",
        "visual_query": "wooden boat construction beach timber",
        "visual_fallback": "beach timber"
      },
      {
        "narration": "Mauritius refused to send a ship. There was a war on. The survivors built stone shelters, kept a fire alive, and waited.",
        "visual_query": "coral stone shelter windswept island",
        "visual_fallback": "stone shelter"
      },
      {
        "narration": "The Dauphine arrived in November 1776. Seven women and an eight-month-old baby were still there. Archaeologists have since dug out their hearths.",
        "visual_query": "archaeological excavation coral sand site",
        "visual_fallback": "excavation site"
      }
    ],
