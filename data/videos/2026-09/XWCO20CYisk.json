  "script": {
    "segments": [
      {
        "narration": "A whole colony vanished and left one word behind. Roanoke Island, fifteen ninety. The word was CROATOAN.",
        "visual_query": "carolina coastal woodland shore",
        "visual_fallback": "coastal forest"
      },
      {
        "narration": "John White had left in fifteen eighty-seven to fetch supplies, including his own daughter and granddaughter Virginia Dare.",
        "visual_query": "elizabethan sailing ship sea",
        "visual_fallback": "wooden sailing ship"
      },
      {
        "narration": "War with Spain trapped him in England for three years. When he finally got back the settlement was standing empty and stripped.",
        "visual_query": "sixteenth century english harbour",
        "visual_fallback": "old port"
      },
      {
        "narration": "The houses had been dismantled, board by board. That is not a raid. That is people packing to move.",
        "visual_query": "colonial timber settlement ruins",
        "visual_fallback": "wooden posts"
      },
      {
        "narration": "White had agreed a code: a cross carved beside the name if they left in danger. There was no cross, and a storm drove him home before he could reach Croatoan.",
        "visual_query": "outer banks island coastline",
        "visual_fallback": "sandy shoreline"
      }
    ],
