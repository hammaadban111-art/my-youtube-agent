  "script": {
    "segments": [
      {
        "narration": "Someone built a stone city on a Pacific reef. Pohnpei, Micronesia. Ninety-two artificial islands, stacked like firewood.",
        "visual_query": "pacific island reef lagoon",
        "visual_fallback": "tropical lagoon"
      },
      {
        "narration": "The walls are natural basalt columns, hexagonal logs of rock, laid crosswise like a log cabin.",
        "visual_query": "columnar basalt rock formation",
        "visual_fallback": "stone columns"
      },
      {
        "narration": "The total is estimated at three quarters of a million tonnes, moved without wheels, without metal, without draught animals.",
        "visual_query": "megalithic stone wall ancient",
        "visual_fallback": "stone wall"
      },
      {
        "narration": "Radiocarbon dates put the megalithic building around eleven eighty, under a dynasty called the Saudeleur.",
        "visual_query": "ancient ruins pacific jungle",
        "visual_fallback": "jungle ruins"
      },
      {
        "narration": "Local tradition says two brothers flew the stones into place. Archaeologists think rafts and levers, and honestly nobody has proved either.",
        "visual_query": "micronesia basalt ruins canal",
        "visual_fallback": "water canal ruins"
      }
    ],
