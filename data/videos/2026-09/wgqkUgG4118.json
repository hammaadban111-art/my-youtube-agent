  "script": {
    "segments": [
      {
        "narration": "One monk wrote a book that weighs 75 kilos. Bohemia, early twelve hundreds, and it takes two people to lift.",
        "visual_query": "medieval monastery scriptorium interior",
        "visual_fallback": "old library"
      },
      {
        "narration": "It stands ninety-two centimetres tall. Three hundred and ten leaves survive, and the hides of about a hundred and sixty animals went into it.",
        "visual_query": "large medieval manuscript pages",
        "visual_fallback": "old book pages"
      },
      {
        "narration": "The handwriting does not change across the whole thing. One scribe, working for years without his letters drifting.",
        "visual_query": "medieval calligraphy quill writing",
        "visual_fallback": "quill pen"
      },
      {
        "narration": "Then you reach page two ninety. A full-page devil, half a metre tall, crouched and staring straight out.",
        "visual_query": "medieval devil illumination art",
        "visual_fallback": "medieval illustration"
      },
      {
        "narration": "Legend says he sold his soul to finish it in one night. Scholars estimate around twenty years of ordinary, patient work.",
        "visual_query": "stockholm library manuscript display",
        "visual_fallback": "library display"
      }
    ],
