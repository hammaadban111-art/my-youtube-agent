      {
        "narration": "A New Hampshire mountain grew five feet taller overnight in 1930. State cartographers stared at their transit scopes in absolute disbelief.",
        "visual_query": "new hampshire granite mountain peak",
        "visual_fallback": "rugged mountain summit landscape"
      },
      {
        "narration": "Government surveyors re-checked their brass bench markers on the summit ridge. Every measurement confirmed the impossible data.",
        "visual_query": "surveyor brass benchmark marker rock",
        "visual_fallback": "old metal survey marker"
      },
      {
        "narration": "Local newspapers blamed shifting tectonic faults or hidden underground caverns collapsing. But how does millions of tons of solid stone suddenly shift vertically?",
        "visual_query": "granite cliff face crevices",
        "visual_fallback": "rocky mountain cliffside"
      },
      {
        "narration": "Geologists discovered that massive subsurface frost action can literally shove solid bedrock upward. Water trapped deep inside microscopic rock fractures froze rapidly.",
        "visual_query": "frost crystals on mountain rock",
        "visual_fallback": "frozen winter rock surface"
      },
      {
        "narration": "Freezing groundwater expands and ratchets the entire crust upward through cryogenesis. Mother Nature built a hydraulic jack right inside the mountain.",
        "visual_query": "frozen mountain ridge aerial view",
        "visual_fallback": "snowy mountain range landscape"
      }
