  "script": {
    "segments": [
      {
        "narration": "There is a book no one on Earth can read. Two hundred and forty pages of tidy handwriting in a script that matches nothing.",
        "visual_query": "medieval illuminated manuscript pages",
        "visual_fallback": "old parchment"
      },
      {
        "narration": "Radiocarbon dating puts the vellum in the early fourteen hundreds, so it is not a Victorian forgery on old skin.",
        "visual_query": "medieval vellum parchment closeup",
        "visual_fallback": "aged paper"
      },
      {
        "narration": "The drawings do not help. Bathing women in green pools, spiral star charts, and plants that match no living species.",
        "visual_query": "botanical illustration medieval herbal",
        "visual_fallback": "hand drawn plants"
      },
      {
        "narration": "Codebreakers who cracked wartime ciphers took it on and lost. Every announced solution has collapsed under review.",
        "visual_query": "cryptography codebreaking desk vintage",
        "visual_fallback": "old typewriter"
      },
      {
        "narration": "Statisticians say the text behaves like a real language, with word patterns a hoaxer would struggle to fake by hand.",
        "visual_query": "yale library rare book",
        "visual_fallback": "library reading room"
      }
    ],
