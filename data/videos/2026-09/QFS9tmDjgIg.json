  "script": {
    "segments": [
      {
        "narration": "A ship abandoned in 1931 kept turning up for decades. Empty, drifting, and always gone again before anyone could claim her.",
        "visual_query": "arctic pack ice open water",
        "visual_fallback": "pack ice"
      },
      {
        "narration": "The Baychimo was a 1,322-ton cargo steamer built in Sweden in 1914, run by the Hudson's Bay Company.",
        "visual_query": "old steel cargo steamer 1920s",
        "visual_fallback": "cargo steamer"
      },
      {
        "narration": "In October 1931, heavy with furs, she jammed solid in pack ice off Barrow, Alaska. The crew camped on the ice beside her.",
        "visual_query": "ship frozen in alaskan sea ice",
        "visual_fallback": "frozen ship"
      },
      {
        "narration": "A blizzard hit that November. When it cleared she was simply gone, and they took the furs out by air and went home.",
        "visual_query": "arctic blizzard snow coastal alaska",
        "visual_fallback": "arctic blizzard"
      },
      {
        "narration": "She was seen off Alaska for 38 years, boarded more than once, never recovered. The last confirmed sighting was 1969.",
