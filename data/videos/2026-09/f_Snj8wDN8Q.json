  "script": {
    "segments": [
      {
        "narration": "America's worst fire was buried by a more famous one. Both started the same night; only one made the history books.",
        "visual_query": "wisconsin pine forest autumn dusk",
        "visual_fallback": "pine forest"
      },
      {
        "narration": "The eighth of October, 1871. Peshtigo, Wisconsin: a timber town in a drought, ringed by slash piles from clearing land.",
        "visual_query": "logging town timber piles 1800s",
        "visual_fallback": "timber piles"
      },
      {
        "narration": "A cold front raised the wind and dozens of small burns merged. Roughly 1.2 million acres went up. Between 1,500 and 2,500 people died.",
        "visual_query": "wildfire wall flames forest night",
        "visual_fallback": "forest wildfire"
      },
      {
        "narration": "Survivors described a fire tornado picking up railway cars and whole houses. The air itself was burning.",
        "visual_query": "fire whirl burning debris smoke",
        "visual_fallback": "fire whirl"
      },
      {
        "narration": "People ran for the Peshtigo River and stood in it for hours. Some drowned. Some died of cold. Chicago burned that same night.",
        "visual_query": "wisconsin river dark water banks",
        "visual_fallback": "river water"
      }
    ],
