  "script": {
    "segments": [
      {
        "narration": "Hunter-gatherers built a stone temple before farming existed. Southeastern Turkey, around nine thousand five hundred BC.",
        "visual_query": "anatolian hill archaeological site",
        "visual_fallback": "dry hillside"
      },
      {
        "narration": "The pillars are T-shaped limestone, up to five and a half metres tall, weighing as much as ten tonnes each.",
        "visual_query": "carved limestone pillar ancient",
        "visual_fallback": "stone pillar"
      },
      {
        "narration": "They are covered in carved animals. Foxes, scorpions, vultures, boars. Not hunting scenes. Something closer to a cast list.",
        "visual_query": "prehistoric animal relief carving",
        "visual_fallback": "carved stone relief"
      },
      {
        "narration": "There is no pottery here, no writing, no sign of anyone living on site. This was built before all of it.",
        "visual_query": "neolithic excavation trench dig",
        "visual_fallback": "excavation site"
      },
      {
        "narration": "And then they filled it in. The enclosures were deliberately backfilled with rubble, which is why the carvings survived at all.",
        "visual_query": "ancient stone circle enclosure",
        "visual_fallback": "stone circle"
      }
    ],
