  "script": {
    "segments": [
      {
        "narration": "A city bigger than London stood in Illinois. Around ten fifty AD, on the Mississippi floodplain, and its name is Cahokia.",
        "visual_query": "mississippi river floodplain landscape",
        "visual_fallback": "wide river"
      },
      {
        "narration": "At its height it held tens of thousands of people, more than London had at the same moment.",
        "visual_query": "grass earthwork mound plain",
        "visual_fallback": "grassy mound"
      },
      {
        "narration": "Monks Mound is the centre of it. Thirty metres high, and its base covers more ground than the Great Pyramid.",
        "visual_query": "monks mound cahokia earthwork",
        "visual_fallback": "earth mound"
      },
      {
        "narration": "They built a circle of red cedar posts to track the sun, and moved an estimated fifty million cubic feet of earth in baskets.",
        "visual_query": "wooden post circle sunrise",
        "visual_fallback": "wooden posts"
      },
      {
        "narration": "By fourteen hundred it was empty. Deforestation, flooding and shifting climate are the leading explanations, and no single one closes the case.",
        "visual_query": "abandoned prairie earthwork dusk",
        "visual_fallback": "empty prairie"
      }
    ],
