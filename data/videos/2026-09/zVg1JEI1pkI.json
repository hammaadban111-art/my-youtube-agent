  "script": {
    "segments": [
      {
        "narration": "Workers were told to lick brushes loaded with radium. New Jersey, nineteen seventeen, painting glow-in-the-dark watch dials.",
        "visual_query": "vintage factory workbench women",
        "visual_fallback": "old factory"
      },
      {
        "narration": "The job was well paid and the paint was fun. Some of the women painted their nails and teeth with it for a night out.",
        "visual_query": "glowing paint dark workshop",
        "visual_fallback": "glowing paint"
      },
      {
        "narration": "Radium behaves like calcium in the body. It went into their bones and stayed, and their jaws began to break apart.",
        "visual_query": "medical x ray bone scan",
        "visual_fallback": "bone scan"
      },
      {
        "narration": "The company said their illnesses were syphilis. Its own consultants had already documented the danger.",
        "visual_query": "1920s newspaper headlines archive",
        "visual_fallback": "old newspaper"
      },
      {
        "narration": "Five women sued in nineteen twenty-seven and settled. Their cases forced the law to recognise disease caused by work, and shaped US safety standards.",
        "visual_query": "historic courthouse exterior daylight",
        "visual_fallback": "old courthouse"
      }
    ],
