  "script": {
    "segments": [
      {
        "narration": "One plutonium sphere killed two scientists in nine months. Los Alamos had cast it for a third atomic bomb that Japan's surrender cancelled.",
        "visual_query": "new mexico desert laboratory 1940s",
        "visual_fallback": "desert laboratory"
      },
      {
        "narration": "August 1945. Harry Daghlian stacked tungsten carbide bricks around the core, bouncing neutrons back in. He fumbled the last brick.",
        "visual_query": "los alamos wartime laboratory bench",
        "visual_fallback": "laboratory bench"
      },
      {
        "narration": "Blue light filled the room. He tore the brick away by hand and died twenty-five days later. The core stayed on that table.",
        "visual_query": "blue glow scientific instrument room",
        "visual_fallback": "blue glow"
      },
      {
        "narration": "May 1946. Louis Slotin ran a similar demonstration, holding two beryllium halves apart with a screwdriver blade.",
        "visual_query": "hands metal sphere physics demonstration",
        "visual_fallback": "metal sphere"
      },
      {
        "narration": "It slipped. Slotin flipped the shell off, died nine days later, and remote handling became mandatory. The core itself was melted down.",
        "visual_query": "remote manipulator arm nuclear facility",
        "visual_fallback": "manipulator arm"
      }
    ],
