  "script": {
    "segments": [
      {
        "narration": "An island invented writing and then forgot it. Rapa Nui, the Pacific. Two dozen carved wooden tablets survive.",
        "visual_query": "easter island coastline statues",
        "visual_fallback": "island coastline"
      },
      {
        "narration": "The glyphs are tiny, carved with obsidian or shark teeth into hard driftwood, and packed edge to edge.",
        "visual_query": "carved wooden tablet glyphs",
        "visual_fallback": "carved wood"
      },
      {
        "narration": "They run in reverse boustrophedon. You read a line, then physically rotate the tablet to read the next one.",
        "visual_query": "polynesian wood artefact museum",
        "visual_fallback": "museum artifact"
      },
      {
        "narration": "By the eighteen seventies the people who could read them were gone, taken by slave raids and epidemics.",
        "visual_query": "nineteenth century pacific ship",
        "visual_fallback": "old ship"
      },
      {
        "narration": "One sequence has been cracked: a lunar calendar on a tablet called Mamari. Everything else is still silent.",
        "visual_query": "moon phases night sky",
        "visual_fallback": "night moon"
      }
    ],
