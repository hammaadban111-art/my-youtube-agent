  "script": {
    "segments": [
      {
        "narration": "A code at CIA headquarters has held since 1990. It is carved into a copper sculpture in the courtyard at Langley.",
        "visual_query": "copper sculpture courtyard installation",
        "visual_fallback": "metal sculpture"
      },
      {
        "narration": "It carries four encrypted passages, cut as letters through sheets of curved copper.",
        "visual_query": "encrypted letters metal panel",
        "visual_fallback": "metal panel"
      },
      {
        "narration": "Three fell. Analysts inside the agency and a computer scientist outside it cracked the first three by nineteen ninety-nine.",
        "visual_query": "cryptography codebreaking computer screen",
        "visual_fallback": "computer screen"
      },
      {
        "narration": "The fourth is ninety-seven characters long. Thirty-five years of professional and amateur attention have not moved it.",
        "visual_query": "sculpture detail engraved characters",
        "visual_fallback": "engraved metal"
      },
      {
        "narration": "Sanborn has leaked four cribs: BERLIN, CLOCK, NORTHEAST, EAST. Even with those, K4 has not opened.",
        "visual_query": "berlin clock landmark evening",
        "visual_fallback": "city landmark"
      }
    ],
