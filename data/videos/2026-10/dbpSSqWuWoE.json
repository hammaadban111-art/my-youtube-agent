  "script": {
    "segments": [
      {
        "narration": "The soil above this grave is thick with mercury. Lintong, near Xi'an, under a hill seventy-six metres tall.",
        "visual_query": "xian china burial mound hill",
        "visual_fallback": "green hill"
      },
      {
        "narration": "Farmers digging a well in 1974 hit its outer edge. Thousands of terracotta soldiers, standing in battle formation.",
        "visual_query": "terracotta army warrior pits",
        "visual_fallback": "clay warriors"
      },
      {
        "narration": "Those were the guards. The tomb itself has never been opened. A historian writing a century later said it held a hundred rivers of mercury, flowing mechanically, under a ceiling of stars.",
        "visual_query": "ancient chinese imperial palace interior",
        "visual_fallback": "palace hall"
      },
      {
        "narration": "For centuries that read as legend. Then surveys measured the soil: mercury far above the regional background, clustered where China's real rivers would sit on a map.",
        "visual_query": "soil sampling drill field china",
        "visual_fallback": "soil survey"
      },
      {
        "narration": "So archaeologists stopped. Terracotta paint flaked away within minutes of exposure in 1974, and nobody can promise better today. The rivers stay sealed until technology catches up.",
        "visual_query": "terracotta warrior close up",
        "visual_fallback": "clay statue"
      }
    ],
    "segment_count": 5,
    "word_count": 122,
    "duration_seconds": 35.0,
    "voice": "en-US-GuyNeural",
    "tts_rate": "+25%",
