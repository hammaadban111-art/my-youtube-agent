      },
      {
        "claim": "In July 1970 an Athena RTV test rocket launched from the Green River Launch Complex in Utah toward White Sands Missile Range in New Mexico went off course and fell in the Mapimi Desert region of Mexico.",
        "segment_index": 1,
        "verdict": "SUPPORTED",
        "note": "96% of the claim's wording appears in the reference article, including 1 number(s)",
        "correction": null,
        "method": "wikipedia-lexical"
      },
      {
        "claim": "The rocket was carrying two small containers of radioactive cobalt-57, and a local resident hired to guard the crash debris during recovery helped spread rumours about the area.",
        "segment_index": 2,
        "verdict": "SUPPORTED",
        "note": "95% of the claim's wording appears in the reference article, including 1 number(s)",
        "correction": null,
        "method": "wikipedia-lexical"
      },
      {
        "claim": "The resulting urban legend holds that radio signals and other communications cannot be received in the area, with claims of spinning compasses, magnetic anomalies, mutated flora and fauna and extraterrestrial visitations, and the area became known as the Zone of Silence.",
        "segment_index": 3,
        "verdict": "SUPPORTED",
        "note": "68% of the claim's wording appears in the reference article",
        "correction": null,
        "method": "wikipedia-lexical"
      },
      {
        "claim": "Andrea Kaus, who carried out doctoral research on the Mapimi Biosphere Reserve, reported that neither she nor anyone she spoke to apart from the local zoneros had any trouble with their radios or compasses, and the legends are used locally to promote tourism.",
        "segment_index": 4,
        "verdict": "SUPPORTED",
