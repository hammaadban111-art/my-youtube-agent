  "script": {
    "segments": [
      {
        "narration": "The US Air Force hauled away hundreds of tonnes of soil. It happened in the Mapimi desert, Durango, Mexico, in July 1970.",
        "visual_query": "chihuahuan desert scrub mexico",
        "visual_fallback": "desert scrub"
      },
      {
        "narration": "An Athena test rocket, launched from Green River, Utah toward White Sands, went off course and came down in the wrong country.",
        "visual_query": "rocket launch desert test range",
        "visual_fallback": "rocket launch"
      },
      {
        "narration": "It carried two small containers of radioactive cobalt-57. Locals hired to guard the wreckage watched soldiers dig for months. Then the stories started.",
        "visual_query": "mexican desert dirt road dusk",
        "visual_fallback": "dirt road"
      },
      {
        "narration": "Compasses spinning. Radios dead. Mutant plants. Visitors landing here to meet aliens. The region got a name: the Zone of Silence.",
        "visual_query": "compass needle closeup desert",
        "visual_fallback": "spinning compass"
      },
      {
        "narration": "Researchers who actually worked there found nothing. Andrea Kaus, who studied the reserve, said nobody but the guides had trouble with radios or compasses. The silence was marketing.",
        "visual_query": "mapimi biosphere reserve desert plain",
        "visual_fallback": "desert plain"
      }
    ],
