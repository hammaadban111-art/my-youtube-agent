  "script": {
    "segments": [
      {
        "narration": "An airliner vanished four minutes from its runway. August 1947, a converted Lancaster bomber crossing the Andes to Santiago.",
        "visual_query": "andes mountains aerial snow peaks",
        "visual_fallback": "andes peaks"
      },
      {
        "narration": "Its last Morse message ended in one word nobody could decode: STENDEC. Sent three times, fast and clean.",
        "visual_query": "vintage morse telegraph key 1940s",
        "visual_fallback": "telegraph key"
      },
      {
        "narration": "Eleven people gone. Searchers combed the mountains for weeks and found nothing at all. How does a plane disappear on a route it flew every week?",
        "visual_query": "andean glacier search party",
        "visual_fallback": "glacier ice"
      },
      {
        "narration": "Fifty-one years later, climbers on Mount Tupungato found a Rolls-Royce Merlin engine melting out of a glacier.",
        "visual_query": "tupungato glacier ice field",
        "visual_fallback": "glacier ice"
      },
      {
        "narration": "The crew had flown into the jet stream, barely understood in 1947. A fierce headwind held them back, so they descended thinking the peaks were behind them. The mountain kept them until the ice let go.",
        "visual_query": "high altitude jet stream clouds",
        "visual_fallback": "storm clouds"
      }
    ],
