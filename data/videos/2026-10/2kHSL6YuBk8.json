  "script": {
    "segments": [
      {
        "narration": "Someone chiselled a pharaoh off her own temple walls. Hatshepsut ruled Egypt for about twenty-one years, carved in stone wearing the false beard of a king.",
        "visual_query": "egyptian temple wall carved hieroglyphs",
        "visual_fallback": "egyptian carvings"
      },
      {
        "narration": "She left the terraced mortuary temple at Deir el-Bahari and twin obelisks at Karnak. One of those obelisks is still standing today.",
        "visual_query": "deir el bahari temple terraces",
        "visual_fallback": "egyptian temple"
      },
      {
        "narration": "Then her name starts vanishing. Cartouches hacked out. Statues smashed and buried. Images plastered over. Why erase the most successful reign in a century?",
        "visual_query": "defaced egyptian stone relief closeup",
        "visual_fallback": "stone relief"
      },
      {
        "narration": "Not revenge. The attacks begin near the end of her stepson's long reign, decades after her death, when any personal grudge had had a lifetime to cool.",
        "visual_query": "karnak temple stone columns luxor",
        "visual_fallback": "temple columns"
      },
      {
        "narration": "Historians read it as paperwork. Make the crown pass straight from father to son, and the woman who reigned in between simply stops having existed.",
        "visual_query": "egyptian obelisk desert evening light",
        "visual_fallback": "egyptian obelisk"
      }
    ],
