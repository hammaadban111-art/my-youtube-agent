  "script": {
    "segments": [
      {
        "narration": "Fifty-five oak posts rose out of a Norfolk beach. The tide had been peeling them free for years before anyone noticed.",
        "visual_query": "norfolk tidal beach mudflats",
        "visual_fallback": "tidal flats"
      },
      {
        "narration": "In 1998 John Lorimer spotted a Bronze Age axe head in the silt. Then a circle appeared, six metres wide, closely fitted.",
        "visual_query": "bronze age oak timber posts",
        "visual_fallback": "weathered timber"
      },
      {
        "narration": "At its centre was an upturned oak stump, roots in the air, over a tonne of it. What was it for?",
        "visual_query": "upturned tree roots coastal sand",
        "visual_fallback": "bare roots"
      },
      {
        "narration": "Tree rings dated every timber to a single felling, spring 2049 BC. One post had a narrow forked gap, the only way in.",
        "visual_query": "oak tree rings cross section",
        "visual_fallback": "tree rings"
      },
      {
        "narration": "That tight ring and single entrance point to a mortuary enclosure, where a body was laid out to the sky. The stump was the platform.",
        "visual_query": "north sea salt marsh dusk",
        "visual_fallback": "coastal dusk"
      }
    ],
