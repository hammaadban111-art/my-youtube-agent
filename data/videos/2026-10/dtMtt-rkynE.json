      {
        "claim": "An account published in 1833 describes heavy lead coffins in the Chase Vault at Christ Church, Barbados, being found disturbed inside a tomb closed by a massive stone door.",
        "segment_index": 0,
        "verdict": "SUPPORTED",
        "note": "80% of the claim's wording appears in the reference article, including 1 number(s)",
        "correction": null,
        "method": "wikipedia-lexical"
      },
      {
        "claim": "By that account the vault was opened for burials in 1812, 1816 and 1819 and the lead coffins were found moved from where they had been left.",
        "segment_index": 1,
        "verdict": "SUPPORTED",
        "note": "86% of the claim's wording appears in the reference article, including 3 number(s)",
        "correction": null,
        "method": "wikipedia-lexical"
      },
      {
        "claim": "The account says Governor Lord Combermere was present in 1819, that the sand floor showed no footprints or water marks, that masons cemented the door shut, and that the coffins were found thrown about when it was reopened in April 1820.",
        "segment_index": 2,
        "verdict": "SUPPORTED",
        "note": "83% of the claim's wording appears in the reference article, including 2 number(s)",
        "correction": null,
        "method": "wikipedia-lexical"
      },
      {
        "claim": "Andrew Lang reported in 1907 that he found no support for the story in the Christ Church burial register or in contemporary Barbados newspapers.",
        "segment_index": 3,
        "verdict": "SUPPORTED",
        "note": "92% of the claim's wording appears in the reference article, including 1 number(s)",
        "correction": null,
        "method": "wikipedia-lexical"
      },
      {
        "claim": "The story rests on the 1833 published account and an unpublished one attributed to Nathan Lucas, and Benjamin Radford's inspection found the vault's brickwork intact with no damage consistent with moving lead coffins.",
        "segment_index": 4,
        "verdict": "SUPPORTED",
        "note": "80% of the claim's wording appears in the reference article, including 1 number(s)",
