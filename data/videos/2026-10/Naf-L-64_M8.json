  "script": {
    "segments": [
      {
        "narration": "Cleveland released one and a half million balloons at once. September 27th, 1986, Public Square, a United Way fundraiser and a world record.",
        "visual_query": "cleveland ohio downtown skyline 1980s",
        "visual_fallback": "city skyline"
      },
      {
        "narration": "The official count was 1,429,643. They rose beautifully for about a minute. Then a cold front rolled in with rain.",
        "visual_query": "colorful balloons rising sky",
        "visual_fallback": "balloon cluster"
      },
      {
        "narration": "Balloons that should have burst high up came straight back down, still inflated. Over a city. Over Lake Erie. What happens next?",
        "visual_query": "lake erie choppy water surface",
        "visual_fallback": "lake water"
      },
      {
        "narration": "A runway at Burke Lakefront airport closed for thirty minutes. Distracted drivers crashed. Spooked horses in Geauga County cost a hundred-thousand-dollar lawsuit.",
        "visual_query": "airport runway rain wet tarmac",
        "visual_fallback": "wet runway"
      },
      {
        "narration": "Worst of all, the Coast Guard was searching the lake for two missing boaters, and could not see the water for balloons. Both men drowned; the Coast Guard says the balloons were not to blame.",
        "visual_query": "coast guard boat lake search",
        "visual_fallback": "rescue boat"
      }
    ],
