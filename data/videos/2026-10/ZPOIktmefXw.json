  "script": {
    "segments": [
      {
        "narration": "He shot the first moving picture, then vanished off a train. Louis Le Prince. October 1888, Leeds \u2014 seconds of his family walking in a garden.",
        "visual_query": "victorian leeds england garden",
        "visual_fallback": "victorian garden"
      },
      {
        "narration": "The 16th of September, 1890. He says goodbye to his brother at Dijon and boards the express for Paris. He never gets off it.",
        "visual_query": "vintage steam train station",
        "visual_fallback": "steam train"
      },
      {
        "narration": "No body. No luggage. Nothing recovered, then or since. And a public showing of his films was already booked in Manhattan.",
        "visual_query": "1890s paris street evening",
        "visual_fallback": "paris street"
      },
      {
        "narration": "The theories piled up. Suicide over money. Murder over the patents, with Edison's camp the suspect. A family quarrel. A simple robbery.",
        "visual_query": "antique film camera mechanism",
        "visual_fallback": "film camera"
      },
      {
        "narration": "A photograph of a drowned man resembling him later surfaced in Paris police files. It is the closest anyone has come. He was declared dead in absentia in 1897.",
        "visual_query": "old police archive documents",
        "visual_fallback": "old documents"
      }
    ],
