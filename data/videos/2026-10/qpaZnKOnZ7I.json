  "script": {
    "segments": [
      {
        "narration": "Escaped bats burned down an American army airfield in 1943. The bats were armed, and that part was the Army's own idea.",
        "visual_query": "new mexico desert airfield",
        "visual_fallback": "desert airfield"
      },
      {
        "narration": "A Pennsylvania dentist had written to the White House a month after Pearl Harbor, proposing bats as incendiary carriers. The plan was approved.",
        "visual_query": "1940s american city street",
        "visual_fallback": "1940s street"
      },
      {
        "narration": "Each casing held 1,040 Mexican free-tailed bats in twenty-six stacked trays, every bat carrying a tiny timed napalm charge. Who signs off on this?",
        "visual_query": "mexican free-tailed bats cave",
        "visual_fallback": "bats cave"
      },
      {
        "narration": "The fire happened during a test at Carlsbad. Observers still called the weapon effective, so the Navy took it over as Project X-Ray.",
        "visual_query": "us navy wwii aircraft",
        "visual_fallback": "wartime aircraft"
      },
      {
        "narration": "Two million dollars in, Admiral Ernest King killed it: bat bombs would not be combat-ready before mid-1945. The atomic bomb got there first.",
        "visual_query": "new mexico desert dusk",
        "visual_fallback": "desert dusk"
      }
    ],
