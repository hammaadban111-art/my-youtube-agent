  "script": {
    "segments": [
      {
        "narration": "A wooden machine beat Napoleon at chess in 1809. Schonbrunn Palace, Vienna: a life-size figure in robes, bolted to a cabinet of gears.",
        "visual_query": "vienna schonbrunn palace baroque hall",
        "visual_fallback": "palace hall"
      },
      {
        "narration": "Wolfgang von Kempelen built it in 1770 for Empress Maria Theresa. Before each game he opened the cabinet doors to prove nothing was inside.",
        "visual_query": "18th century european palace interior",
        "visual_fallback": "candlelit room"
      },
      {
        "narration": "It played Benjamin Franklin. It toured London, Leipzig, Havana, Baltimore. Eighty-four years on the road, mostly winning.",
        "visual_query": "antique chess board pieces closeup",
        "visual_fallback": "chess pieces"
      },
      {
        "narration": "So how does a box of cogs read a chessboard? Edgar Allan Poe published his theory in 1836 and got most of it wrong.",
        "visual_query": "19th century engraving candlelit study",
        "visual_fallback": "old engraving"
      },
      {
        "narration": "A man was folded inside on a sliding seat, reading moves off magnets under each square. In 1827 the operator fainted in Baltimore and two boys watched him climb out.",
        "visual_query": "antique wooden cabinet gears mechanism",
        "visual_fallback": "wooden gears"
      }
    ],
