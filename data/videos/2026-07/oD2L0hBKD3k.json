  "script": {
    "segments": [
      {
        "narration": "August 16, 1942. A Navy blimp drifted out of the Pacific fog and scraped along a quiet street in Daly City.",
        "visual_keywords": "foggy coastal town street"
      },
      {
        "narration": "First responders pried open the gondola door. Inside: a working radio, a wet raincoat, and the throttle still set to half-power.",
        "visual_keywords": "vintage aircraft cockpit interior"
      },
      {
        "narration": "Two veteran pilots were gone. So ask yourself: how do two men evaporate in mid-air without ever touching the radio?",
        "visual_keywords": "cloudy sky overhead cinematic"
      },
      {
        "narration": "Navy ships searched miles of open ocean. No parachutes were deployed. No bodies ever washed ashore.",
        "visual_keywords": "dark stormy ocean waves"
      },
      {
        "narration": "The blimp's flight recorder proved the aircraft never touched the water. Whatever took those pilots came from inside the sky.",
        "visual_keywords": "empty dark horizon clouds"
      }
    ],
